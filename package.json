{
  "name": "uml-cad-v5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "build:native": "tsc -p tsconfig.native.json",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "test:native": "node --test --import tsx \"test/native-*.test.ts\"",
    "check": "npm run build && npm test",
    "check:native": "npm run build:native && npm run test:native",
    "serve": "node kernel/server.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
